{
  "extends": "../tsconfig.json",
  "exclude": [],
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "../src/**/*.ts",
    "../src/**/*.tsx"
  ],
  "compilerOptions": {
    "rootDir": "..",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "paths": {
      "@payload-config": [
        "./payload.config.ts"
      ],
      "@inoo-ch/payload-image-optimizer": [
        "../src/index.ts"
      ],
      "@inoo-ch/payload-image-optimizer/client": [
        "../src/exports/client.ts"
      ],
      "@inoo-ch/payload-image-optimizer/frontend": [
        "../src/exports/frontend.ts"
      ],
      "@inoo-ch/payload-image-optimizer/next": [
        "../src/exports/next.ts"
      ],
      "@inoo-ch/payload-image-optimizer/rsc": [
        "../src/exports/rsc.ts"
      ]
    },
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "emitDeclarationOnly": false
  }
}
